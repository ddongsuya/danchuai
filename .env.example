# 서버(apps/server) 환경 변수. 실제 값은 배포 환경에만 넣는다.
AGENT_PROVIDER=anthropic        # anthropic | openai
AGENT_MODEL=claude-sonnet-5-5   # openai일 때는 반드시 지정
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PORT=8787

# 회의 녹음 전사(기관 비서). 비우면 녹음 버튼이 "설정 전"으로 안내한다.
# 녹음은 서버를 거치지 않고 앱이 Deepgram 으로 바로 보낸다(서버는 임시 토큰만 발급, mip_opt_out=true).
DEEPGRAM_API_KEY=
STT_MODEL=nova-3                # 한국어 지원 모델
STT_LANGUAGE=ko
AGENT_PRICE_STT_PER_MIN=0.0043  # 분당 달러(이용량 상한 계산용)
STT_MAX_MINUTES=180
